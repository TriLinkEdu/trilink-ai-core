# Plugin selection — swap implementations by changing these values
TRACER_PLUGIN=bkt
GENERATOR_PLUGIN=groq
EMBEDDER_PLUGIN=minilm
RECOMMENDER_PLUGIN=vector

# Infrastructure
POSTGRES_URL=postgresql://user:password@localhost:5432/trilink
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/trilink

# External APIs
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=

# Security — set this to require X-API-Key header on all /api/ai/* endpoints
# Leave empty to disable auth (dev mode)
INTERNAL_API_KEY=

# BKT tuning (optional — defaults shown)
BKT_P_INIT=0.1
BKT_P_LEARN=0.3
BKT_P_SLIP=0.1
BKT_P_GUESS=0.25

# Thresholds
MASTERY_THRESHOLD=0.70
RECOMMENDATION_LIMIT=5
